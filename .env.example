# =============================================================================
# ResuMesh Admin - Root Environment Configuration Example
# Copy this file to .env for Docker Compose setup.
# =============================================================================

# Backend Configuration
APP_NAME="ResuMesh Admin Backend API"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
CORS_ORIGINS="*"

# Auth & Secrets
JWT_SECRET_KEY="your_super_secret_jwt_key_here"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin_password_here"

# Supabase PostgreSQL Connection String (PgBouncer Pooler)
DATABASE_URL="postgresql://postgres.ahrbyydizkchgoocsifx:your_password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# Supabase Cloud URL & API Key
SUPABASE_URL="https://ahrbyydizkchgoocsifx.supabase.co"
SUPABASE_KEY="sb_publishable_your_key_here"

# Frontend Configuration
VITE_API_URL="http://localhost:8001"
VITE_SUPABASE_URL="https://ahrbyydizkchgoocsifx.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_your_key_here"
