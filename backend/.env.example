# =============================================================================
# ResuMesh Admin - Backend Environment Configuration Example
# Copy this file to .env and configure your values.
# =============================================================================

# Core Server Settings
APP_NAME="ResuMesh Admin Backend API"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8001
LOG_LEVEL="INFO"
FRONTEND_URL="http://localhost:5173"

# Authentication & JWT Secrets
JWT_SECRET_KEY="your_super_secret_jwt_key_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SUPABASE_JWT_SECRET=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin_password_here"

# Database & Supabase Connection (PgBouncer Pooler)
DATABASE_URL="postgresql://postgres.ahrbyydizkchgoocsifx:your_password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"
SUPABASE_URL="https://ahrbyydizkchgoocsifx.supabase.co"
SUPABASE_KEY="sb_publishable_your_key_here"

# CORS Configuration
CORS_ORIGINS="http://localhost:8081,http://localhost:5173,http://127.0.0.1:8081"
CORS_ALLOWED_ORIGINS=""

# Ingestion / Scraper Credentials (GitHub, Medium, Dev.to)
GITHUB_USERNAME=""
GITHUB_PAT=""
MEDIUM_USERNAME=""
DEVTO_USERNAME=""
DEVTO_API_KEY=""

# Reactive Resume Connection
REACTIVE_RESUME_URL="https://rxresu.me"
REACTIVE_RESUME_API_KEY=""
RXRESUME_API_KEY=""

# LLM & AI Provider Configuration (Providers: mock, openai, groq, ollama)
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Monitoring & Telemetry
SENTRY_DSN=""

# Feature Flags & Deployment Webhooks
ENABLE_ADMIN_WORKSPACE=true
ENABLE_CRON_JOBS=true
DEPLOY_WEBHOOK_URL=""
